datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MODELOS DE AUTENTICAÇÃO E USUÁRIO
// ==========================================

model User {
  id          String  @id @default(uuid())
  firebaseUid String? @unique // UID do Firebase Auth (opcional: usuários do Better Auth não têm)
  email       String  @unique
  name        String?
  phone       String?
  cpf         String? @unique
  avatar      String? // URL da foto de perfil

  // Endereço
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Dados acadêmicos
  educationLevel String? // ENSINO_MEDIO, GRADUACAO, POS_GRADUACAO
  currentSchool  String?

  // Status
  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  // Preferências
  receiveEmails   Boolean @default(true)
  receiveSms      Boolean @default(true)
  receiveWhatsapp Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relacionamentos
  favorites     Favorite[]
  enrollments   Enrollment[]
  searchHistory SearchHistory[]
  adminProfile  AdminUser?

  @@index([email])
  @@index([firebaseUid])
  @@index([cpf])
}

model Favorite {
  id              String  @id @default(uuid())
  userId          String
  courseId        String // ID do curso na API externa
  courseName      String
  courseSlug      String
  institutionName String?
  modalidade      String?
  price           Float?
  discount        Float?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model Enrollment {
  id     String @id @default(uuid())
  userId String

  // Dados do curso
  courseId        String
  courseName      String
  institutionName String
  modalidade      String
  turno           String?

  // Valores
  originalPrice Float?
  finalPrice    Float?
  discount      Float?

  // Status
  status        EnrollmentStatus @default(PENDING)
  paymentStatus PaymentStatus    @default(PENDING)

  // Datas
  enrollmentDate DateTime?
  startDate      DateTime?

  // Referências externas
  externalId String? // ID no sistema externo
  paymentId  String? // ID do pagamento

  // Tracking (UTMify / atribuição de marketing)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  src         String? // custom UTMify "src"
  sck         String? // custom UTMify "sck"
  ipAddress   String?

  // Idempotência dos disparos pra UTMify (evita reenviar no mesmo status)
  utmifyWaitingSentAt DateTime?
  utmifyPaidSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model SearchHistory {
  id     String @id @default(uuid())
  userId String

  query      String?
  course     String?
  city       String?
  state      String?
  modalidade String?
  nivel      String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EnrollmentStatus {
  PENDING // Aguardando matrícula
  IN_PROGRESS // Matrícula em andamento
  ENROLLED // Matriculado
  CANCELLED // Cancelado
  COMPLETED // Concluído
}

enum PaymentStatus {
  PENDING // Aguardando pagamento
  PROCESSING // Processando
  PAID // Pago
  FAILED // Falhou
  REFUNDED // Reembolsado
  CANCELLED // Cancelado
}

// ==========================================
// MODELO DE LEADS (CAPTURA DE INTERESSADOS)
// ==========================================

model Lead {
  id          String   @id @default(uuid())
  name        String
  cpf         String? // Opcional: leads de teste vocacional não pedem CPF
  email       String
  phone       String
  // Data de nascimento: o formulário sempre pediu, mas até 2026-08-11 o dado
  // era enviado só à Cogna/Athena e descartado do nosso lado. @db.Date porque
  // é data pura — sem hora, sem fuso, sem risco de virar o dia na conversão.
  birthDate   DateTime? @db.Date
  courseNames String[] // Cursos de interesse

  // Dados do curso (se disponível)
  courseId        String?
  courseName      String?
  institutionName String?
  modalidade      String?

  // Origem do lead (checkout, teste-vocacional, etc) + payload livre
  source    String?
  extraData Json?

  // Status do lead
  status      LeadStatus @default(NEW)
  convertedAt DateTime? // Data de conversão (quando virou enrollment)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpf])
  @@index([email])
  @@index([status])
  @@index([source])
}

enum LeadStatus {
  NEW // Novo lead
  CONTACTED // Contactado
  INTERESTED // Interessado
  CONVERTED // Convertido (fez matrícula)
  LOST // Perdido
}

// ==========================================
// TRANSAÇÕES DE PAGAMENTO
// ==========================================

model Transaction {
  id String @id @default(uuid())

  // Dados do pagador
  name  String
  cpf   String
  email String
  phone String

  // Referência ao Lead (se existir)
  leadId String?

  // Dados do curso
  courseId        String?
  courseName      String?
  institutionName String?

  // Valores
  amountInCents Int // Valor em centavos

  // IDs externos
  externalTransactionId String? @unique // ID da transação no Elysium/gateway
  elysiumStudentId      String? // ID do estudante no Elysium

  // PIX
  pixBrCode       String? @db.Text
  pixQrCodeBase64 String? @db.Text

  // Status
  status        TransactionStatus @default(PENDING)
  paymentMethod String            @default("pix")

  // Metadados
  metadata Json?

  // Datas
  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpf])
  @@index([email])
  @@index([status])
  @@index([externalTransactionId])
}

enum TransactionStatus {
  PENDING // Aguardando pagamento
  PROCESSING // Processando
  PAID // Pago
  FAILED // Falhou
  CANCELLED // Cancelado
  EXPIRED // Expirado
  REFUNDED // Reembolsado
}

// ==========================================
// CUPONS DE DESCONTO
// ==========================================

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique // Código do cupom (ex: SUMMER2024)
  description String? // Descrição do cupom
  discount    Float // Valor do desconto
  type        CouponType // PERCENT ou FIXED
  maxUses     Int? // Máximo de usos (null = ilimitado)
  usedCount   Int        @default(0) // Quantas vezes foi usado
  validFrom   DateTime   @default(now()) // Data de início da validade
  validUntil  DateTime? // Data de expiração (null = sem expiração)
  isActive    Boolean    @default(true)

  // ID do cupom no Elysium (se sincronizado)
  elysiumCouponId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin que criou

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
}

enum CouponType {
  PERCENT // Desconto em porcentagem
  FIXED // Desconto em valor fixo (centavos)
}

// ==========================================
// MODELOS DE ADMINISTRAÇÃO
// ==========================================

model AdminUser {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        AdminRole @default(EDITOR)
  permissions String[] // Permissões: help_center, courses, users, dashboard, admin_management

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // ID do admin que criou

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AdminRole {
  SUPER_ADMIN // Acesso total
  ADMIN // Todas funcionalidades exceto gerenciar admins
  EDITOR // Apenas gerenciamento de conteúdo
}

// ==========================================
// CENTRAL DE AJUDA (CMS)
// ==========================================

model HelpCategory {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  description String
  icon        String // Nome do ícone Lucide: "Info", "BookOpen", etc.
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles HelpArticle[]

  @@index([slug])
  @@index([isActive])
}

model HelpArticle {
  id          String @id @default(uuid())
  categoryId  String
  slug        String
  title       String
  description String // Descrição curta para cards
  content     String @db.Text // Conteúdo completo (HTML ou Markdown)

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String[]

  order       Int       @default(0)
  isActive    Boolean   @default(true)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin que criou
  updatedBy String? // Último admin que atualizou

  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

// ==========================================
// CURSOS EM DESTAQUE
// ==========================================

model FeaturedCourse {
  id            String      @id @default(uuid())
  slug          String      @unique
  apiCourseName String // Nome usado na API
  name          String // Nome de exibição
  fullName      String // Nome completo com tipo
  type          CourseType
  nivel         CourseLevel

  description     String
  longDescription String @db.Text
  duration        String

  areas        String[] // Áreas de atuação
  skills       String[] // Habilidades desenvolvidas
  careerPaths  String[] // Carreiras possíveis
  coreSubjects String[] // Disciplinas principais da grade curricular (8-12 itens)

  averageSalary String
  marketDemand  MarketDemand

  imageUrl String // URL da imagem no Firebase Storage
  imageAlt String?

  keywords String[] // Palavras-chave para SEO

  order    Int     @default(0)
  isActive Boolean @default(true)

  // SEO programmatic: só emite /cursos/[slug]/[city] pra cursos com conteúdo
  // editorial rico + inventário real (gate manual; default false).
  hasCityPages Boolean @default(false)

  // Marca cursos enriquecidos via scripts/enrich-courses.mjs (vs cadastro manual no admin).
  enrichedAt     DateTime?
  enrichmentNote String?   @db.Text

  // Score 0-100 do Google Trends (volume de busca relativo no Brasil).
  // Usado para priorizar sitemap, decidir indexação de city pages sem oferta
  // local e ordenar grids de cursos relacionados. Atualizado via
  // scripts/refresh-course-trends.ts (cron semanal recomendado).
  trendScore        Int       @default(0)
  trendScoreFetched DateTime?

  // Mapa { "SP": 78, "RJ": 65, ... } por sigla de estado. Best-effort: nem todo
  // curso tem dado regional disponível (Google Trends limita rate). Usado pelo
  // <LocalDemandBlock /> pra diferenciar city pages.
  regionalTrends Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([order])
  @@index([hasCityPages])
  @@index([trendScore])
}

// Cache de offerCount por (FeaturedCourse × city). Alimentado por
// scripts/precompute-city-offers.ts (cron diário/semanal). Substitui a chamada
// live ao Tartarus no momento de gerar sitemap pra (a) reduzir latência,
// (b) permitir filtro mais agressivo (só URLs com offerCount real ≥1 entram).
model CityCourseOfferCache {
  id               String   @id @default(cuid())
  featuredCourseId String
  citySlug         String
  // offerCount/minPrice/fetchedAt = fonte COGNA (Tartarus). Semântica original
  // preservada: o corte de 14 dias do sitemap lê `fetchedAt` esperando isso.
  offerCount       Int      @default(0)
  minPrice         Float?
  fetchedAt        DateTime @default(now())
  // Fonte ATHENA (YDUQS: Estácio, IBMEC, Wyden). Carimbo próprio porque as duas
  // fontes falham de forma independente e podem ser gravadas em rodadas
  // diferentes — atualizar um pelo outro faria número velho parecer fresco.
  // Coluna separada (em vez de somar em offerCount) porque o rollout do gate é
  // FASEADO: hoje só o Grupo A usa contagem mesclada. Ver resolveOfferCountForGate
  // em app/cursos/[slug]/[city]/page.tsx antes de mudar quem lê o quê.
  athenaOfferCount Int      @default(0)
  athenaMinPrice   Float?
  athenaFetchedAt  DateTime?

  @@unique([featuredCourseId, citySlug])
  @@index([citySlug])
  @@index([featuredCourseId])
  @@index([offerCount])
}

// Inventário de ofertas por MARCA × cidade (Fase 4 — faculdade city pages).
// Análogo ao CityCourseOfferCache, mas agrupado por marca (normalizeBrand) em vez
// de curso. Populado por scripts/precompute-institution-city-offers.ts a partir da
// API viva (Tartarus p/ Cogna + Athena p/ Estácio). É a fonte ESTÁVEL que o
// sitemap E a página /faculdades/[slug]/em/[city] usam pra decidir index/noindex
// (mata o flip-flop de fetch ao vivo). Substitui a leitura da FaculdadeCurso legada
// (que nunca foi populada neste repo).
model InstitutionCityOfferCache {
  id         String   @id @default(cuid())
  brand      String // chave de marca normalizada (normalizeBrand): "anhanguera", "estacio", ...
  citySlug   String
  offerCount Int      @default(0)
  minPrice   Float?
  fetchedAt  DateTime @default(now())

  @@unique([brand, citySlug])
  @@index([citySlug])
  @@index([brand])
  @@index([offerCount])
}

// Maior desconto REAL por MARCA (nacional, graduação), calculado
// PERIODICAMENTE por scripts/precompute-institution-max-discount.ts — nunca
// no momento do render. /faculdades/[slug] LÊ este valor (título, meta
// description, H1, resposta GEO e FAQ saem todos daqui, na mesma
// renderização) em vez de derivar das ofertas ao vivo a cada visita.
//
// Por quê: a API do catálogo (Tartarus/Athena) falha de duas formas que
// produzem zero — HTTP 400 embrulhando um 429 do parceiro (lança erro) e
// HTTP 200 com lista vazia sob carga (não lança nada, escapa de qualquer
// catch) — e a página tem ISR de 24h, então um zero de falha ficava
// congelado como afirmação pública por um dia inteiro. Duas tentativas de
// derivar isso no render foram revertidas por esse motivo (2026-09-02).
//
// O script SÓ faz upsert quando a medição não teve nenhuma falha de busca E
// colheu amostra ≥ MIN_SAMPLE_TO_WRITE (ver o script) — uma medição ruim
// PRESERVA o registro anterior em vez de sobrescrever com zero. Todo row
// que existe nesta tabela é, por construção, uma medição confiável; a
// leitura ainda revalida sampleSize contra o piso de evidência pra decidir
// entre HAS_DISCOUNT/NO_DISCOUNT/UNKNOWN (defesa em profundidade).
model InstitutionMaxDiscountCache {
  id             String   @id @default(cuid())
  /** Chave de marca normalizada (normalizeBrand → slug): "anhanguera", "ibmec", ... */
  brand          String   @unique
  /**
   * Maior desconto % medido nas ofertas de graduação da marca — BRUTO, sem
   * nenhum teto editorial aplicado (renomeado de `maxDiscountPct` em
   * 2026-09-02: o nome antigo, combinado com o comentário "já truncado",
   * fez o script gravar `Math.min(x, DISCOUNT_CEILING_PCT)` — quando
   * DISCOUNT_CEILING_PCT subiu de 78 pra 80 (claims.ts), os valores
   * persistidos ficaram travados em 78 até alguém reprocessar. O teto
   * pertence à LEITURA (getBrandDiscountState/getDisplayDiscountPct em
   * app/lib/utils/institution-discount.ts), não à gravação — assim, mudar a
   * constante vale pro site inteiro sem reprocessar dado nenhum. 0 é um
   * valor LEGÍTIMO (ex.: IBMEC) — só é gravado quando sampleSize comprova
   * que não é um zero de falha (ver script).
   */
  maxDiscountPctRaw  Int
  /** Nº de ofertas com desconto > 0 encontradas na medição (informativo). */
  offersWithDiscount Int      @default(0)
  /**
   * Nº TOTAL de ofertas de graduação coletadas na medição — o denominador
   * que dá evidência à leitura: sampleSize baixo demais faz a página cair
   * no estado seguro (UNKNOWN) mesmo com um row presente, em vez de afirmar
   * ausência de bolsa com pouca base.
   */
  sampleSize         Int
  measuredAt         DateTime @default(now())

  @@index([brand])
}

enum CourseType {
  BACHARELADO
  LICENCIATURA
  TECNOLOGO
  ESPECIALIZACAO
  MBA
  PROFISSIONALIZANTE
}

enum CourseLevel {
  GRADUACAO
  POS_GRADUACAO
  CURSO_PROFISSIONALIZANTE
}

enum MarketDemand {
  ALTA
  MEDIA
  BAIXA
}

// ==========================================
// BANNERS (SLIDER DA HOMEPAGE)
// ==========================================

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String // URL da imagem no Tigris Storage
  linkUrl   String? // Link opcional ao clicar no banner
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  // Segmentação por site: chaves de `SiteKey` (bolsaclick | bolsamais | anhanguera).
  // Array VAZIO = exibe em todos os sites (compatível com os banners já
  // cadastrados antes desse campo existir, que sempre apareceram em todo lugar).
  targetSites String[] @default([])
  // Período de vigência opcional. NULL em qualquer um dos dois lados = sem
  // limite naquele lado (ex.: só `endsAt` = "exibir até tal data").
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ==========================================
// LOG DE ATIVIDADES (AUDITORIA)
// ==========================================

model ActivityLog {
  id          String @id @default(uuid())
  adminUserId String
  action      String // CREATE, UPDATE, DELETE
  entity      String // HelpCategory, HelpArticle, FeaturedCourse
  entityId    String
  details     Json? // Campos alterados

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([entity])
  @@index([createdAt])
}

// ==========================================
// CONFIGURAÇÕES GERAIS DO SITE
// ==========================================

model SiteSettings {
  id String @id @default("default")

  // Contato
  whatsappNumber String @default("5511936200198")
  contactEmail   String @default("contato@bolsaclick.com.br")
  contactPhone   String @default("(11) 93620-0198")

  // Redes Sociais
  facebookUrl  String @default("https://facebook.com/bolsaclickbrasil")
  instagramUrl String @default("https://instagram.com/bolsaclick")
  linkedinUrl  String @default("https://linkedin.com/company/bolsaclick")

  // SEO
  siteName        String @default("Bolsa Click")
  siteDescription String @default("O maior marketplace de bolsas de estudo do Brasil")
  logoUrl         String @default("/assets/logo-bolsa-click-rosa.png")

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ==========================================
// INSTITUIÇÕES (FACULDADES PARCEIRAS)
// ==========================================

model Institution {
  id                String          @id @default(uuid())
  slug              String          @unique
  name              String // "Anhanguera"
  shortName         String // "ANHANGUERA"
  fullName          String // "Universidade Anhanguera"
  description       String
  longDescription   String          @db.Text
  founded           Int?
  type              InstitutionType
  campusCount       Int?
  studentCount      String? // "500.000+"
  coursesOffered    Int?
  headquartersCity  String?
  headquartersState String?
  mecRating         Int? // 1-5
  emecLink          String?
  modalities        String[] // ["EAD", "PRESENCIAL", "SEMIPRESENCIAL"]
  academicLevels    String[] // ["GRADUACAO", "POS_GRADUACAO"]
  highlights        String[] // Diferenciais
  logoUrl           String
  imageUrl          String
  imageAlt          String?
  keywords          String[]
  metaTitle         String?
  metaDescription   String?
  isActive          Boolean         @default(true)

  // SEO programmatic: só emite /faculdades/[slug]/[city] pra instituições com
  // ampla presença em múltiplas cidades (manual gate; default false).
  hasCityPages      Boolean         @default(false)

  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  reviews         Review[]
  responderEmails InstitutionResponderEmail[]

  @@index([slug])
  @@index([isActive])
}

enum InstitutionType {
  PRIVADA
  PUBLICA_FEDERAL
  PUBLICA_ESTADUAL
}

// ==========================================
// REVIEWS (avaliações de faculdades)
// ==========================================

model Review {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Autor (público)
  authorName      String
  authorEmail     String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Conteúdo
  rating     Int // 1-5
  recommends Boolean
  body       String  @db.Text

  // Moderação
  status       ReviewStatus @default(PENDING)
  moderatedAt  DateTime?
  moderatedBy  String? // uid do admin
  rejectReason String?

  // Resposta da faculdade
  response       String?   @db.Text
  respondedAt    DateTime?
  responderEmail String? // email do responsável que respondeu

  // Anti-spam / auditoria
  ip        String?
  userAgent String?

  verificationTokens ReviewVerificationToken[]
  responseTokens     InstitutionResponseToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, status])
  @@index([authorEmail])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING // aguardando verificação de email ou moderação
  APPROVED // visível
  REJECTED // descartado pelo admin
  SPAM // descartado como spam
}

model ReviewVerificationToken {
  token     String    @id
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([reviewId])
  @@index([email])
}

model InstitutionResponderEmail {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  email         String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, email])
  @@index([email])
}

model InstitutionResponseToken {
  token         String    @id
  reviewId      String
  review        Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  institutionId String
  email         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([reviewId])
  @@index([email])
}

// ==========================================
// TESTE VOCACIONAL (resultado compartilhável)
// ==========================================

model VocationalTestResult {
  id          String   @id @default(uuid())
  shareToken  String   @unique // hex 16 chars pra URL pública
  hollandCode String              // ex: "SIA"
  profileData Json                // ProfileResult completo (perfil + cursos)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([shareToken])
}

// ==========================================
// BLOG (CONTENT HUB PARA SEO)
// ==========================================

model BlogCategory {
  id              String  @id @default(uuid())
  slug            String  @unique
  title           String
  description     String
  order           Int     @default(0)
  isActive        Boolean @default(true)
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[] @relation("BlogPostCategories")

  @@index([slug])
  @@index([isActive])
}

model BlogPost {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String    @db.Text // HTML content
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  featuredImage   String? // URL da imagem no Tigris Storage
  imageAlt        String?
  author          String    @default("Equipe Bolsa Click")
  readingTime     Int       @default(5) // minutos
  tags            String[]
  isActive        Boolean   @default(true)
  featured        Boolean   @default(false)
  publishedAt     DateTime? // null = rascunho

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  categories BlogCategory[] @relation("BlogPostCategories")

  @@index([slug])
  @@index([isActive])
  @@index([publishedAt])
  @@index([featured])
}

// ==========================================
// WHATSAPP BOT (MEMÓRIA DE CONVERSAS)
// ==========================================

model WhatsappMemory {
  id        String   @id @default(uuid())
  phone     String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

// ==========================================
// MODELOS EXISTENTES (CURSOS)
// ==========================================

model Curso {
  id         String @id @default(uuid())
  nome       String
  slug       String
  brand      String @default("anhanguera")
  externalId String

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  faculdades FaculdadeCurso[]

  @@unique([slug, brand])
  @@unique([brand, externalId])
}

model Unidade {
  id          String           @id @default(uuid())
  externalId  String           @unique
  nome        String
  endereco    String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String
  estado      String
  cep         String
  turno       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  faculdades  FaculdadeCurso[]
}

model FaculdadeCurso {
  id            String    @id @default(uuid())
  cursoId       String
  unidadeId     String
  modalidade    String
  turno         String
  precoOriginal Float?
  precoComBolsa Float?
  vencimento    DateTime?
  ofertaId      String?
  origem        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  curso   Curso   @relation(fields: [cursoId], references: [id])
  unidade Unidade @relation(fields: [unidadeId], references: [id])

  @@unique([cursoId, unidadeId, modalidade, turno])
}

// ==========================================
// SEO GAP ANALYSIS (Google Trends)
// ==========================================

model SeoTrendsSnapshot {
  id        String       @id @default(uuid())
  topic     String // Termo da watchlist OU nome de curso/instituição
  source    TrendsSource
  timeframe String // ex: "now 7-d", "today 30-d"
  region    String       @default("BR")
  rawData   Json // resposta completa do fetcher (debug/audit)
  fetchedAt DateTime     @default(now())

  entries SeoTrendsEntry[]

  @@index([topic])
  @@index([fetchedAt])
}

model SeoTrendsEntry {
  id              String         @id @default(uuid())
  snapshotId      String
  query           String
  normalizedQuery String
  trendValue      Int // 0-100 do Trends
  isRising        Boolean        @default(false)
  risingPercent   Int?
  matchStatus     GapMatchStatus
  matchedEntities String[] // ex: ["featuredCourse:psicologia", "blogPost:slug-do-post"]
  priorityScore   Float
  dismissed       Boolean        @default(false)
  dismissedAt     DateTime?
  notes           String?        @db.Text

  createdAt DateTime @default(now())

  snapshot SeoTrendsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([matchStatus])
  @@index([priorityScore])
  @@index([dismissed])
  @@index([normalizedQuery])
}

enum TrendsSource {
  CURATED
  COURSE_CATALOG
  INSTITUTION_CATALOG
}

enum GapMatchStatus {
  GAP // 0 matches no catálogo
  PARTIAL // match parcial (ex: keyword bate mas não tem página dedicada)
  COVERED // match exato (slug ou title)
}

// ==========================================
// BETTER AUTH (migração Firebase→Better Auth, Fase 1)
// Tabelas próprias (ba_*) pra conviver com o `User` (perfil) existente.
// Vínculo authUser↔User será por email na migração de usuários.
// ==========================================

model AuthUser {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // plugin admin
  role          String?   @default("user")
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("ba_user")
}

model AuthSession {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ba_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("ba_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ba_verification")
}
